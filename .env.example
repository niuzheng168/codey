PORTAL_HOST=127.0.0.1
PORTAL_PORT=4310
# PORTAL_USERNAME=zhn
# PORTAL_PASSWORD=change-me
# Production unified login uses a salted verifier and revocable sessions, not
# PORTAL_PASSWORD or the legacy AAD flow. Never put real credentials in this file.
# PORTAL_AUTH_MODE=password
# PORTAL_PASSWORD_CREDENTIAL=<JSON verifier, supplied through an ACA secret>
# PORTAL_AUTH_STATE_DIR=/data/portal-auth
# PORTAL_WORKSPACE_SSO_MASTER=<32 random bytes, base64url, supplied through an ACA secret>
# PORTAL_CLIENT_TICKET_TTL_SECONDS=60
# COPILOT_API_KEY_LOCAL=
# COPILOT_API_KEY_WESTUS2=
# COPILOT_API_KEY_JPE2=
# COPILOT_API_KEY_JPE3=

# CloudCLI VNet reverse proxy (ACA only)
# PORTAL_PUBLIC_BASE_URL=https://codey.example.com
# PORTAL_CLOUDCLI_CONFIG=Q:\codex_manager\config\cloudcli-nodes.aca.json
# Optional, authenticated private Usage/History API; browser direct remains the default.
# PORTAL_NODE_DATA_CONFIG=Q:\codex_manager\config\node-data.aca.json
# PORTAL_NODE_DATA_CA_FILE=Q:\codex_manager\config\codey-node-ca.pem

# Codey-managed CloudCLI dictation. These keys belong ONLY in the portal's
# server environment / ACA secrets, never VITE_* variables or VM env files.
# Azure Speech may use the verified Speech endpoint of the same Foundry resource.
# FOUNDRY_ENDPOINT=https://your-resource.services.ai.azure.com/api/projects/your-project
# FOUNDRY_API_KEY=<server-only-key>
# The deployment helper also accepts the Foundry portal's FOUNDRY_KEY alias and
# SPEECH_ENDPOINT alias, normalizing them without editing the original .env.
# Alternatively configure an explicit Azure Speech resource:
# AZURE_SPEECH_ENDPOINT=https://your-speech.cognitiveservices.azure.com/
# AZURE_SPEECH_KEY=<server-only-key>
# MAI uses Speech enhanced transcription in a supported region, NOT
# /openai/deployments/.../audio/transcriptions. Keep its resource/key explicit.
# MAI_TRANSCRIBE_SPEECH_ENDPOINT=https://your-mai-speech.cognitiveservices.azure.com/
# MAI_TRANSCRIBE_KEY=<server-only-key>
# MAI_TRANSCRIBE_MODEL=MAI-Transcribe-2
# To use an already-tested Speech endpoint with MAI 1.5, the deployment helper
# accepts --mai-model MAI-Transcribe-1.5. Use --secret-suffix <version> for rotation
# so the previous ACA revision keeps its original endpoint/key pair for rollback.
